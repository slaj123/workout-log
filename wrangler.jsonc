{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workout-log",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workout-log",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (never in this file), set with `wrangler secret put`:
  //   WORKOUT_PASSCODE  the app's passcode (12+ characters)
  //   SESSION_SECRET    random, 32+ characters; signs the login cookie
  //   INGEST_SECRET     random, 24+ characters; the Watch Shortcut and the
  //                     voice Worker send it as X-Ingest-Secret
  // Locally they come from .dev.vars.
}
